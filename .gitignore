# dependencies
node_modules/

# Only bun.lock is committed (convenciones §7)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native: android/ and ios/ are generated by prebuild (ADR-0007)
/ios
/android
.kotlin/
# Gradle output of the local native modules
/modules/*/android/build/
/modules/*/android/.cxx/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local environment variables
.env*.local
# Not named .env*: Expo's dev bundle would pick it up (require.context over .env*), service_role key included.
.seed.local

# TypeScript
*.tsbuildinfo

# tests
coverage/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
