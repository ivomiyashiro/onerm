    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "react-native-svg-transformer": "^1.5.3",
    "supabase": "^2.121.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "device:android": "expo run:android --device",
    "device:android:release": "expo run:android --variant release --device",
    "device:ios": "expo run:ios --device",
    "device:ios:release": "expo run:ios --configuration Release --device",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0 && tools/ci/no-javascript.sh",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:int": "jest -c jest.int.config.json",
    "seed:catalog": "bun tools/catalog-seed/cli.ts",
    "seed:catalog:cloud": "bun --env-file=.seed.local tools/catalog-seed/cli.ts --load",
    "test:supabase": "supabase test db && jest -c jest.supabase.config.json",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "perf": "jest -c jest.perf.config.json"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "patchedDependencies": {
    "react-native-worklets@0.10.1": "patches/react-native-worklets@0.10.1.patch"
  }
